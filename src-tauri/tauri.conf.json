{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOL助手",
  "mainBinaryName": "LOLAssistant",
  "version": "1.1.0",
  "identifier": "com.lolassistant.app",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://localhost:34115",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LOL助手",
        "width": 1680,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 780,
        "decorations": false,
        "center": true,
        "backgroundColor": "#f6f7f9",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQjZBMzIwMjFDMDVGQTMKUldTalg4QWhJS08ya1Fuemlid29MMUJPSHlCUVJjWEF0RGNJakdVUkZLdVNubW5uUmV2Z2dnN2IK",
      "endpoints": [
        "https://raw.githubusercontent.com/1712872354/lol-assistant/dist/latest.json",
        "https://github.com/1712872354/lol-assistant/releases/latest/download/latest.json"
      ]
    }
  }
}